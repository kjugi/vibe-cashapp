# Local / Vercel env for the backup server. Do not commit real values.

# Google OAuth web client. The VITE_ value is baked into the PWA; the others stay on the server.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the 90-day app session after Google login. Falls back to VAPID_PRIVATE_KEY if unset.
# SESSION_SECRET=

# Optional: extra browser origins allowed by /api CORS (comma-separated).
# ALLOWED_ORIGINS=https://your-custom-domain.example

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects GET /api/cron (Vercel Cron sends this automatically when set)
CRON_SECRET=

# Linked Vercel Blob store. On Vercel this is usually injected; locally `vercel env pull`.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
