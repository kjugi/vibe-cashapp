# Local / Vercel env for the backup server. Do not commit real values.

# Shared secret the PWA sends as `Authorization: Bearer …`
CASHBOOK_TOKEN=

# Optional: bake the same token into the client so Settings can connect without paste.
# VITE_CASHBOOK_TOKEN=

# Optional: PWA on another origin (GitHub Pages) talking to this Vercel API.
# VITE_API_URL=https://your-app.vercel.app
# ALLOWED_ORIGINS=https://kjugi.github.io

# Web Push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects GET /api/cron (Vercel Cron sends this automatically when set)
CRON_SECRET=

# Linked Vercel Blob store. On Vercel this is usually injected; locally `vercel env pull`.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
